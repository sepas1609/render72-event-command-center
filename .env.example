# ==============================================================================
# FlagHorizon Sentinel — Render72 Event Command Center
# Environment Configuration Template
# ==============================================================================

# Render72 Events API Base URL (CORS open, no auth required)
# Used by Server Components, Client Hooks, and Fallback Cache Engine
NEXT_PUBLIC_API_URL=https://render72.pages.dev
VITE_API_URL=https://render72.pages.dev

# Node Environment
NODE_ENV=production

# Server Port (Defaults to 3000)
PORT=3000

# Telemetry & Optimization Flags
NEXT_TELEMETRY_DISABLED=1
